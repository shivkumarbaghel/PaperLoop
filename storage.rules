rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.role in ["platform_admin", "super_admin"];
    }

    function publisherStaff(publisherId) {
      return signedIn()
        && request.auth.token.publisherIds is list
        && publisherId in request.auth.token.publisherIds;
    }

    function canManagePublisher(publisherId) {
      return isPlatformAdmin() || publisherStaff(publisherId);
    }

    function safeAsset() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType == "application/pdf"
          || request.resource.contentType.matches("image/.*")
          || request.resource.contentType.matches("video/.*")
        );
    }

    match /publishers/{publisherId}/{allPaths=**} {
      allow read: if true;
      allow write: if canManagePublisher(publisherId) && safeAsset();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && safeAsset();
    }
  }
}
